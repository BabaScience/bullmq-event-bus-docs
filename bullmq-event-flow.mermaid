sequenceDiagram
    autonumber
    participant Client
    participant OrderService
    participant Queue as BullMQ Queue<br/>(Redis)
    participant Worker1 as Worker 1<br/>(Inventory)
    participant Worker2 as Worker 2<br/>(Notification)
    participant Worker3 as Worker 3<br/>(Analytics)
    participant InventoryService
    participant NotificationService
    participant AnalyticsService
    participant Monitor as Monitoring<br/>(Prometheus)
    participant DLQ as Dead Letter Queue
    
    rect rgb(200, 220, 255)
        Note over Client,OrderService: Phase 1: Event Publication
        Client->>OrderService: POST /orders (Create Order)
        activate OrderService
        OrderService->>OrderService: Validate & Persist Order
        OrderService->>Queue: Publish "order.created" Event
        Note right of Queue: Job ID: job-12345<br/>Priority: 1<br/>Attempts: 0/3<br/>State: WAITING
        Queue->>Queue: Persist to Redis<br/>Add to Waiting List
        Queue-->>OrderService: Job Confirmation
        OrderService-->>Client: 202 Accepted<br/>{orderId: "ORD-123"}
        deactivate OrderService
    end
    
    rect rgb(220, 255, 220)
        Note over Queue,Worker3: Phase 2: Event Distribution & Processing
        
        par Parallel Event Consumption
            Worker1->>Queue: Poll for Jobs
            Queue-->>Worker1: Fetch "order.created" Event
            Note right of Worker1: State: ACTIVE<br/>Locked by Worker1<br/>Attempts: 1/3
            Worker1->>Worker1: Deserialize Event Payload
            Worker1->>InventoryService: Process Event
            activate InventoryService
            InventoryService->>InventoryService: Reserve Inventory
            InventoryService->>Queue: Publish "inventory.reserved"
            InventoryService-->>Worker1: Success Response
            deactivate InventoryService
            Worker1->>Queue: Mark Job COMPLETED
            Note right of Queue: State: COMPLETED<br/>Result: {status: 'ok'}
            Worker1->>Monitor: Emit Success Metrics
            
        and Notification Processing
            Worker2->>Queue: Poll for Jobs
            Queue-->>Worker2: Fetch "order.created" Event
            Worker2->>NotificationService: Process Event
            activate NotificationService
            NotificationService->>NotificationService: Send Email/SMS
            NotificationService-->>Worker2: Success
            deactivate NotificationService
            Worker2->>Queue: Mark Job COMPLETED
            Worker2->>Monitor: Emit Success Metrics
            
        and Analytics Processing
            Worker3->>Queue: Poll for Jobs
            Queue-->>Worker3: Fetch "order.created" Event
            Worker3->>AnalyticsService: Process Event
            activate AnalyticsService
            AnalyticsService->>AnalyticsService: Track Metrics
            AnalyticsService-->>Worker3: Success
            deactivate AnalyticsService
            Worker3->>Queue: Mark Job COMPLETED
            Worker3->>Monitor: Emit Success Metrics
        end
    end
    
    rect rgb(255, 220, 220)
        Note over Queue,DLQ: Phase 3: Error Handling Scenario
        Worker1->>Queue: Poll for Jobs
        Queue-->>Worker1: Fetch "payment.process" Event
        Worker1->>InventoryService: Process Event
        activate InventoryService
        InventoryService->>InventoryService: External API Call FAILS
        InventoryService-->>Worker1: Error: Timeout
        deactivate InventoryService
        
        alt Attempt 1 Failed
            Worker1->>Queue: Mark Job FAILED (Attempt 1/3)
            Note right of Queue: State: WAITING<br/>Retry in: 2 seconds<br/>Backoff: Exponential
            Worker1->>Monitor: Emit Failure Metrics
            
            Note over Queue: Wait 2 seconds...
            
            Worker1->>Queue: Poll for Retry
            Queue-->>Worker1: Fetch Job (Attempt 2)
            Worker1->>InventoryService: Process Event (Retry)
            activate InventoryService
            InventoryService-->>Worker1: Error: Connection Refused
            deactivate InventoryService
            Worker1->>Queue: Mark Job FAILED (Attempt 2/3)
            Note right of Queue: Retry in: 4 seconds<br/>Backoff: Exponential
            
            Note over Queue: Wait 4 seconds...
            
            Worker1->>Queue: Poll for Retry
            Queue-->>Worker1: Fetch Job (Attempt 3)
            Worker1->>InventoryService: Process Event (Final Attempt)
            activate InventoryService
            InventoryService-->>Worker1: Error: Service Unavailable
            deactivate InventoryService
        end
        
        Worker1->>Queue: Mark Job FAILED (Max Attempts)
        Note right of Queue: State: FAILED<br/>All retries exhausted
        Worker1->>DLQ: Move to Dead Letter Queue
        Note right of DLQ: Job stored for<br/>manual intervention
        Worker1->>Monitor: Emit Critical Alert
        Monitor->>Monitor: Trigger PagerDuty Alert
    end
    
    rect rgb(255, 245, 200)
        Note over Queue,Monitor: Phase 4: Monitoring & Observability
        loop Every 30 seconds
            Monitor->>Queue: Query Queue Metrics
            Queue-->>Monitor: waiting: 10<br/>active: 5<br/>completed: 1000<br/>failed: 3<br/>delayed: 50
            Monitor->>Monitor: Calculate Throughput<br/>Update Dashboards<br/>Check SLA Compliance
        end
    end
